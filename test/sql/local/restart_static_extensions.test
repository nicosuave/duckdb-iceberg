# name: test/sql/local/restart_static_extensions.test
# description: iceberg's required dependencies (parquet, avro) must reload after a restart, even when they are only statically linked and AutoLoadExtension cannot see them.
# group: [local]

require avro

require parquet

require iceberg

statement ok
select 1;

restart

query IIII
select * from iceberg_scan('{WORKING_DIRECTORY}/data/persistent/null_stats/default/test_nulls', version='00003-9d6a621e-8a72-4190-a880-f6ca02e32b86') order by all
----
1	a	2024-03-01 13:33:20+00	true
2	b	2024-03-02 17:20:00+00	false
3	c	2024-03-03 21:06:40+00	true
4	d	2024-03-05 00:53:20+00	NULL
5	e	2024-03-06 04:40:00+00	NULL
6	f	2024-03-07 08:26:40+00	true
7	g	2024-03-08 12:13:20+00	NULL
8	h	2024-03-09 16:00:00+00	NULL
9	i	2024-03-10 19:46:40+00	NULL

# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/filtering/test_delete_descriptor_index.test
# description: Positional descriptor candidates are indexed by partition or path, including late manifest loads
# group: [filtering]

require-env CATALOG_TEST_CONFIG_SETUP

require-env FORMAT_V3_SUPPORT

include test/sql/init_requires

statement ok
set iceberg_use_server_side_scan_planning=false;

statement ok
set threads=1;

statement ok
call enable_logging('Iceberg', storage='memory');

statement ok
set logging_level='debug';

# DuckDB v2 descriptors also carry referenced paths. Preserve NULL partition applicability.
statement ok
drop table if exists my_datalake.default.delete_descriptor_partition;

statement ok
create table my_datalake.default.delete_descriptor_partition (part integer, id integer)
partitioned by (part) with ('format-version'=2, 'commit.manifest-merge.enabled'='false');

statement ok
insert into my_datalake.default.delete_descriptor_partition values
(NULL, 0), (NULL, 1), (1, 2), (1, 3), (2, 4), (2, 5);

statement ok
delete from my_datalake.default.delete_descriptor_partition where id % 2 = 0;

statement ok
call truncate_duckdb_logs();

query II rowsort
select part, id from my_datalake.default.delete_descriptor_partition;
----
1	3
2	5
NULL	1

# Observe candidate pruning, not merely the final row count.
query I
select count(*) > 0 from duckdb_logs()
where type='Iceberg' and message.contains('phase=delete_index_lookup indexed_entries=3 candidates=1');
----
true

statement ok
drop table my_datalake.default.delete_descriptor_partition;

# Two files per partition and two separate delete manifests. With one scan thread,
# the other partition's manifest is published after the first index was queried.
statement ok
drop table if exists my_datalake.default.delete_descriptor_path;

statement ok
create table my_datalake.default.delete_descriptor_path (part integer, id integer)
partitioned by (part) with ('format-version'=3, 'commit.manifest-merge.enabled'='false');

statement ok
insert into my_datalake.default.delete_descriptor_path values (1, 10), (1, 11), (1, 12), (2, 20), (2, 21), (2, 22);

statement ok
insert into my_datalake.default.delete_descriptor_path values (1, 13), (1, 14), (1, 15), (2, 23), (2, 24), (2, 25);

statement ok
delete from my_datalake.default.delete_descriptor_path where part=1 and id in (10, 13);

statement ok
delete from my_datalake.default.delete_descriptor_path where part=2 and id in (20, 23);

statement ok
call truncate_duckdb_logs();

query II rowsort
select part, id from my_datalake.default.delete_descriptor_path;
----
1	11
1	12
1	14
1	15
2	21
2	22
2	24
2	25

query I
select count(*) from duckdb_logs()
where type='Iceberg' and message.contains('phase=delete_manifest_scan_started selected_delete_manifests=1 total_delete_manifests=2');
----
2

# Each manifest has two descriptors in the same partition: exact referenced paths
# reduce each lookup to the one corresponding deletion vector.
query I
select count(*) from duckdb_logs()
where type='Iceberg' and message.contains('phase=delete_index_lookup indexed_entries=2 candidates=1');
----
4

# Consolidation invalidates committed descriptors and replaces them with transaction
# descriptors. Subsequent scans must use the transaction's current set.
statement ok
begin transaction;

statement ok
delete from my_datalake.default.delete_descriptor_path where id=11;

query I rowsort
select id from my_datalake.default.delete_descriptor_path;
----
12
14
15
21
22
24
25

statement ok
delete from my_datalake.default.delete_descriptor_path where id=21;

query I rowsort
select id from my_datalake.default.delete_descriptor_path;
----
12
14
15
22
24
25

statement ok
rollback;

query I rowsort
select id from my_datalake.default.delete_descriptor_path;
----
11
12
14
15
21
22
24
25

statement ok
drop table my_datalake.default.delete_descriptor_path;

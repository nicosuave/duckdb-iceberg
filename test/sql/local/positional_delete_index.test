# name: test/sql/local/positional_delete_index.test
# description: Partition and sequence candidate lookup for positional deletes without referenced paths
# group: [local]

require iceberg

statement ok
call enable_logging('Iceberg', storage='memory');

statement ok
set threads=1;

statement ok
call truncate_duckdb_logs();

# Each partition (including NULL) has two delete descriptors, at sequences 1 and 2.
# Data has sequence 2: its equal-sequence delete applies, while the older one does not.
query II rowsort
select part, id from iceberg_scan('data/persistent/positional_delete_index/metadata/v1.metadata.json');
----
1	1
2	1
NULL	1

# Each lookup finds just one of six descriptors, using both partition and sequence.
query I
select count(*) from duckdb_logs()
where type='Iceberg' and message.contains('phase=delete_index_lookup indexed_entries=6 candidates=1');
----
3

statement ok
call truncate_duckdb_logs();

# There is one exact-path descriptor per file and one shared multi-path descriptor.
# Only the shared descriptor must fall back to the unpartitioned bucket.
query I rowsort
select id from iceberg_scan('data/persistent/positional_delete_path_bounds/metadata/v1.metadata.json');
----
2
2

query I
select count(*) from duckdb_logs()
where type='Iceberg' and message.contains('phase=delete_index_lookup indexed_entries=3 candidates=2');
----
2
